  "panels": [
    {
      "datasource": "Prometheus",
      "gridPos": {"h": 3, "w": 24, "x": 0, "y": 0},
      "id": 0,
      "options": {
        "content": "<p style=\"font-size: 14px;\">This host uses <strong>cgroup v2 + systemd</strong>. cAdvisor reports Docker containers via systemd scope paths (e.g. <code>/system.slice/docker-&lt;hash&gt;.scope</code>) instead of friendly names. The <code>id</code> label is used for series matching and legends.</p><p style=\"font-size: 14px;\"><strong>Network I/O limitation:</strong> cAdvisor on cgroup v2 cannot attribute network traffic to individual containers. Network panels show <strong>host-level</strong> stats per interface instead.</p>",
        "mode": "html"
      },
      "pluginVersion": "8.0.0",
      "title": "",
      "type": "text"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "custom": {"align": null, "filterable": false},
          "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]}
        },
        "overrides": []
      },
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 3},
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "textMode": "auto"
      },
      "pluginVersion": "8.0.0",
      "targets": [
        {
          "expr": "count(count by (id) (container_last_seen{id=~\"/system.slice/docker-.*\\\\.scope\"}))",
          "refId": "A"
        }
      ],
      "title": "Running Containers",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "custom": {"align": null, "filterable": false},
          "mappings": [],
          "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}]},
          "unit": "percent"
        },
        "overrides": []
