# Copy to .env (chmod 600) and fill in real values.
# Generation commands are in README.md — quick recap:
#
#   head -c32 /dev/urandom | base64                 # for COOKIE_SECRET / SHARED_SECRET
#   openssl ecparam -genkey -name prime256v1 -noout \
#     | base64 -w0                                  # for SIGNING_KEY

# 32-byte base64 random — used to encrypt the auth cookie.
COOKIE_SECRET=REPLACE_ME_BASE64_32_BYTES

# 32-byte base64 random — used for inter-component auth (envoy <-> pomerium).
SHARED_SECRET=REPLACE_ME_BASE64_32_BYTES

# base64-encoded PEM ECDSA P-256 private key — signs the X-Pomerium-Jwt-Assertion
# attestation token consumed by upstream apps (e.g. the verify app).
SIGNING_KEY=REPLACE_ME_BASE64_PEM_ECDSA_P256
